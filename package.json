{
  "name": "omega-lines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "payload": "node --env-file=.env.local ./node_modules/payload/bin.js",
    "payload:types": "node --env-file=.env.local ./node_modules/payload/bin.js generate:types",
    "payload:migrate:create": "node --env-file=.env.local ./node_modules/payload/bin.js migrate:create",
    "payload:migrate": "node --env-file=.env.local ./node_modules/payload/bin.js migrate",
    "homepage:sync": "node --env-file=.env.local --import tsx src/payload/sync-homepage-profile.ts",
    "seed": "node --env-file=.env.local --import tsx src/payload/seed.ts",
    "about:sync": "node --env-file=.env.local --import tsx src/payload/sync-about-profile.ts",
    "products:import": "node --env-file=.env.local --import tsx src/payload/import-product-assets.ts",
    "products:static-assets": "node scripts/import-static-product-assets.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.4.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@payloadcms/db-postgres": "^3.86.0",
    "@payloadcms/next": "^3.86.0",
    "@payloadcms/richtext-lexical": "^3.86.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-intl": "^4.13.2",
    "payload": "^3.86.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.83.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
