# Local / Production
DATABASE_URL=postgres://omega_lines:omega_lines_password@localhost:5433/omega_lines
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for the bundled catalog-import image directory
# PRODUCT_ASSETS_ROOT=D:/path/to/product-assets

# Set to "true" to seed demo categories, products, and gallery items
# SEED_DEMO_CONTENT=true

# Client review preview — no database required
# UI_REVIEW_MODE=true
# PAYLOAD_SECRET=<temporary strong secret>
# NEXT_PUBLIC_SITE_URL=<vercel preview URL>
# NEXT_PUBLIC_SERVER_URL=<vercel preview URL>
# DATABASE_URL is NOT required in review mode
